{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "edit": "ask",
    "bash": "ask",
    "webfetch": "allow",
    "grep": "allow",
    "glob": "allow",
    "apply_patch": "ask"
  },
  "agent": {
    "build": {
      "mode": "primary",
      "description": "Full development agent for builds and fixes",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "grep": "allow",
        "glob": "allow",
        "apply_patch": "allow"
      },
      "temperature": 0.2
    },
    "plan": {
      "mode": "primary",
      "description": "Analysis and planning agent (read-only by default)",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "webfetch": "allow",
        "grep": "allow",
        "read": "allow"
      },
      "temperature": 0.0
    }
  }
}
