{
  "$defs": {
    "EvidenceStep": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/Span"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "parents": {
          "items": {
            "type": "string"
          },
          "title": "Parents",
          "type": "array"
        },
        "graph_edge": {
          "anyOf": [
            {
              "$ref": "#/$defs/GraphEdge"
            },
            {
              "type": "null"
