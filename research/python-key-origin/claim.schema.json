        "type": "string"
      },
      "title": "Origins",
      "type": "array"
    },
    "origin_set_complete": {
      "title": "Origin Set Complete",
      "type": "boolean"
    },
    "modality": {
      "enum": [
        "must",
        "may",
        "unknown"
      ],
      "title": "Modality",
      "type": "string"
    },
    "unresolved_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Reasons",
      "type": "array"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceStep"
      },
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "operation_id",
    "target_api",
    "target",
    "source_sha256",
    "context_backend",
    "immediate_boundary",
    "status",
    "origins",
    "origin_set_complete",
    "modality",
    "unresolved_reasons",
    "assumptions",
    "evidence"
  ],
  "title": "KeyOriginClaim",
  "type": "object"
}
